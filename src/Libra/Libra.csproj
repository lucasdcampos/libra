<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningLevel>0</WarningLevel>
    <AssemblyName>libra-interpretador</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>../../bin/Libra/</OutputPath>
    <Version>0.1.2</Version>
    <SatelliteResourceLanguages></SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Propriedade global (passada via -p:LibraWasm=true) que ativa o build web-safe:
       define LIBRA_WASM e remove a dependência do Roslyn (incompatível com browser-wasm). -->
  <PropertyGroup Condition="'$(LibraWasm)' == 'true'">
    <DefineConstants>$(DefineConstants);LIBRA_WASM</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(LibraWasm)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>

  <!-- Biblioteca padrão (.libra) embutida no assembly. Permite resolver
       `importar vetores`, `importar matematica`, etc. mesmo sem filesystem
       (ex.: playground WebAssembly). Ver Libra.BibliotecaEmbutida. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\biblioteca\*.libra">
      <LogicalName>Biblioteca/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
